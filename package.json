{
	"name": "armazi-hud",
	"description": "Presentation-only status strip for the DSH web GUI: renders existing session state (thinking, tool categories, runtime metrics, todos, compaction state) into the conversation dock — zero model-side changes, zero dependencies",
	"version": "0.1.0",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"dsh": "0.2.x"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [],
			"platform": "web"
		}
	},
	"author": {
		"name": "Caqtus",
		"url": "https://github.com/Caqtus"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Caqtus/armazi-hud"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"plugin",
		"client-plugin",
		"status-bar",
		"hud",
		"web"
	],
	"files": [
		"lib",
		"cordis.patch.yml",
		"smoke.js",
		"cover.png",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"test": "node smoke.js"
	},
	"license": "MIT"
}